# Dependencies
node_modules/

# Build output — never commit or deploy from here directly
dist/
dist-ssr/

# Local env files
.env
.env.*
.env.local
.env.*.local

# Editor/OS
.DS_Store
*.log
npm-debug.log*

# Vite
.vite/

# ── Security: secrets & data must never be committed (T1 remediation) ────────
# NOTE: rules for files that are currently still TRACKED (api/config.php,
# sql-dump.md) take effect only after the approved untracking / history-purge
# step — see SECURITY_REMEDIATION_PLAN.md. config.example.php stays tracked.
api/config.php
api/config.local.php
api/config.production.php
*.sql
# Migrations under api/sql/ ARE version-controlled (additive schema DDL only —
# never dumps/data/secrets). Enforced by scripts/validate-sql.mjs (predeploy).
!api/sql/
!api/sql/*.sql
sql-dump.md
*_dump*
backups/
deploy-package*
UNSAFE_DO_NOT_DEPLOY*

test-results/
